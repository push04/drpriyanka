-center justify-center bg-[#faf9f6] p-4\">\r\n            <Card className=\"w-full max-w-md shadow-xl border-none\">\r\n                <CardHeader className=\"text-center space-y-4\">\r\n                    <div className=\"mx-auto bg-[#2d5016]/10 w-16 h-16 rounded-full flex items-center justify-center\">\r\n                        <Leaf className=\"w-8 h-8 text-[#2d5016]\" />\r\n                    </div>\r\n                    <CardTitle className=\"text-2xl font-serif font-bold text-[#2d5016]\">Welcome Back</CardTitle>\r\n                    <CardDescription>\r\n                        Sign in to access your dashboard\r\n                    </CardDescription>\r\n                </CardHeader>\r\n                <CardContent>\r\n                    <form onSubmit={handleLogin} className=\"space-y-4\">\r\n                        <div className=\"space-y-2\">\r\n                            <Label htmlFor=\"email\">Email</Label>\r\n                            <Input\r\n                                id=\"email\"\r\n                                type=\"email\"\r\n                                placeholder=\"john@example.com\"\r\n                                value={email}\r\n                                onChange={(e) => setEmail(e.target.value)}\r\n                                required\r\n                            />\r\n                        </div>\r\n                        <div className=\"space-y-2\">\r\n                            <div className=\"flex items-center justify-between\">\r\n                                <Label htmlFor=\"password\">Password</Label>\r\n                                <Link href=\"#\" className=\"text-xs text-muted-foreground hover:text-[#2d5016]\">\r\n                                    Forgot password?\r\n                                </Link>\r\n                            </div>\r\n                            <Input\r\n                                id=\"password\"\r\n                                type=\"password\"\r\n                                placeholder=\"ΓÇóΓÇóΓÇóΓÇóΓÇóΓÇóΓÇóΓÇó\"\r\n                                value={password}\r\n                                onChange={(e) => setPassword(e.target.value)}\r\n                                required\r\n                            />\r\n                        </div>\r\n\r\n                        {error && (\r\n                            <div className=\"text-sm text-red-500 bg-red-50 p-2 rounded text-center\">\r\n                                {error}\r\n                            </div>\r\n                        )}\r\n\r\n                        <Button\r\n                            type=\"submit\"\r\n                            className=\"w-full bg-[#2d5016] hover:bg-[#2d5016]/90 text-white\"\r\n                            disabled={isLoading}\r\n                        >\r\n                            {isLoading ? <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" /> : \"Sign In\"}\r\n                        </Button>\r\n                    </form>\r\n                </CardContent>\r\n                <CardFooter className=\"justify-center\">\r\n                    <p className=\"text-sm text-muted-foreground\">\r\n                        Don't have an account?{\" \"}\r\n                        <Link href=\"/signup\" className=\"text-[#2d5016] font-medium hover:underline\">\r\n                            Create Account\r\n                        </Link>\r\n                    </p>\r\n                </CardFooter>\r\n            </Card>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pushp\\Downloads\\PRIYANKAMAM1\\dr-priyanka-clinic\\src\\app\\not-found.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":21,"column":97,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[1008,1