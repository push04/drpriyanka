)}\r\n                                    />\r\n                                </div>\r\n                            </div>\r\n\r\n                            <div className=\"space-y-2\">\r\n                                <Label>Flow Quality & Issues</Label>\r\n                                <Textarea\r\n                                    placeholder=\"Describe any issues like heavy flow, pain (PMS), PCOS history...\"\r\n                                    value={formData.menstrual_history?.flow_quality || \"\"} // Mapping flow_quality to general text for now as existing schema has issues array but text is easier for user\r\n                                    onChange={(e) => updateMenstrual('flow_quality', e.target.value)}\r\n                                />\r\n                            </div>\r\n                        </>\r\n                    )}\r\n                </CardContent>\r\n            </Card>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pushp\\Downloads\\PRIYANKAMAM1\\dr-priyanka-clinic\\src\\components\\layout\\Footer.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":43,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":43,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1434,1437],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1434,1437],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":160,"column":65,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"a